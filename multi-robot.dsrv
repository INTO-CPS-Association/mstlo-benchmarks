// cargo run --profile dev-fast --features ros -- examples/distributed/distributed_paper_r5.dsrv --input-ros-file examples/distributed/distributed_paper_r4_map.json/

in R4Odom: Struct<pose: Struct<pose: Struct<position: Struct<x: Float, y: Float, z: Float>, ...>, ...>, ...>

in ConveyorSystem: Int
in StackerCrane: Int
in VerticalLift: Int
in HorizontalCarousel: Int

out CS4Alert: Int
out SC4Alert: Int
out VL4Alert: Int
out HC4Alert: Int

// Bounding areas of RX and Machine Y
out baR4C: Bool
out baR4S: Bool
out baR4V: Bool
out baR4H: Bool

// Robot positions
aux R4: Struct<x: Float, y: Float, z: Float>

// Machine static coords:
aux C: Struct<x: Float, y: Float>
aux S: Struct<x: Float, y: Float>
aux V: Struct<x: Float, y: Float>
aux H: Struct<x: Float, y: Float>

// Bounding area size constant
aux D: Float

aux CPred: Bool
aux SPred: Bool
aux VPred: Bool
aux HPred: Bool

// Extract the position of Robots from odometry data
R4= R4Odom.pose.pose.position

// Coordinates of machines (static)
C = {"x": 3.5, "y": 3.0}
S = {"x": 3.5, "y": -6.0}
V = {"x": -4.0, "y": -6.0}
H = {"x": -4.0, "y": 3.0}

// Bounding box = 10 units wide = robot is maximum five units away from center
D = 5.0 // Or 10.0 / 2.0

// Probabilistic predicates for machine states:
CPred = ConveyorSystem > 0
SPred = StackerCrane > 0 && StackerCrane < 30
VPred = VerticalLift < 100
HPred = HorizontalCarousel == 0

// Bounding areas for machines (with subst. values):
// -1.5 <= x <= 8.5 && -2.0 <= y <= 8.0 for ConveyorSystem
baR4C = abs(R4.x - C.x) <= D && abs(R4.y - C.y) <= D

baR4S = abs(R4.x - S.x) <= D && abs(R4.y - S.y) <= D

baR4V = abs(R4.x - V.x) <= D && abs(R4.y - V.y) <= D

baR4H = abs(R4.x - H.x) <= D && abs(R4.y - H.y) <= D

CS4Alert = if baR4C then if CPred then 1 else 0 else -1
SC4Alert = if baR4S then if SPred then 1 else 0 else -1
VL4Alert = if baR4V then if VPred then 1 else 0 else -1
HC4Alert = if baR4H then if HPred then 1 else 0 else -1
